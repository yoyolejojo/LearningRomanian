---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase.js';

const { data: lessons } = await supabase
  .from('lessons').select('*').order('number', { ascending: true });

const completed = lessons?.filter(l => l.completed).length ?? 0;
const total = lessons?.length ?? 0;
---

<Layout title="Leçons">
  <div class="container page-lessons">
    <div class="page-header">
      <div>
        <h1 class="serif">Leçons</h1>
        <p class="text-muted">Assimil — <em>Le Roumain</em></p>
      </div>
      <div style="text-align:right;">
        <span class="text-faint" style="font-size:13px;display:block;">{completed} / {total} complétées</span>
        <a href="/lessons/new" class="btn btn-primary" style="margin-top:8px;padding:7px 16px;font-size:13px;">+ Nouvelle leçon</a>
      </div>
    </div>

    <div class="lessons-list">
      {lessons?.map(lesson => (
        <a href={`/lessons/${lesson.number}`} class={`lesson-item ${lesson.completed ? 'done' : ''}`}>
          <span class="serif text-gold lesson-num">{lesson.number < 10 ? '0'+lesson.number : lesson.number}</span>
          <div class="lesson-body">
            <div class="lesson-ro">{lesson.title_ro}</div>
            <div class="lesson-fr">{lesson.title_fr}</div>
          </div>
          {lesson.completed
            ? <span class="badge badge-success">✓</span>
            : <span class="text-faint" style="font-size:18px;">›</span>
          }
        </a>
      ))}
    </div>
  </div>
</Layout>

<style>
  .page-lessons { padding-top: 32px; padding-bottom: 40px; }
  .page-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 24px;
    gap: 12px;
  }
  .page-header h1 { font-size: 30px; margin-bottom: 4px; }

  .lessons-list { display: flex; flex-direction: column; gap: 8px; }
  .lesson-item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 18px;
    border-radius: var(--radius);
    background: var(--bg-card);
    border: 0.5px solid var(--border);
    text-decoration: none;
    transition: all 0.18s;
  }
  .lesson-item:hover { border-color: var(--border-hover); }
  .lesson-item.done { opacity: 0.55; }
  .lesson-item.done:hover { opacity: 1; }
  .lesson-num { font-size: 20px; min-width: 30px; }
  .lesson-body { flex: 1; min-width: 0; }
  .lesson-ro { font-size: 15px; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lesson-fr { font-size: 13px; font-style: italic; color: var(--text-muted); margin-top: 2px; }

  @media (max-width: 600px) {
    .page-lessons { padding-top: 24px; }
    .lesson-item { padding: 13px 14px; gap: 12px; }
    .lesson-num { font-size: 17px; }
    .lesson-ro { font-size: 14px; }
  }
</style>
